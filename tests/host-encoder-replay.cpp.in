using Clock = std::chrono::steady_clock;
inline std::atomic<bool> replayError {false};
struct NullLog {
    bool error;
    explicit NullLog(const char* level) : error(std::strcmp(level, "error") == 0 || std::strcmp(level, "fatal") == 0) { if (error) replayError = true; }
    ~NullLog() { if (error) std::cerr << '\n'; }
    template<typename T> NullLog& operator<<(const T& value) { if (error) std::cerr << value; return *this; }
};
#define BOOST_LOG(level) NullLog{#level}

namespace replay {
struct Scene { std::string id; std::vector<unsigned char> pixels; };
struct Event { long long atUs; int scene; bool activity, recovery; };
struct Provenance { int event = 0, scene = 0; long long captureUs = 0, submitUs = 0; int64_t input = -1; };
inline Clock::time_point start;
inline thread_local Provenance current;
inline thread_local int64_t inputIndex = -1;
inline thread_local OSStatus averageSetStatus = kVTPropertyNotSupportedErr;
inline thread_local OSStatus limitsSetStatus = kVTPropertyNotSupportedErr;
inline thread_local OSStatus minQpSetStatus = kVTPropertyNotSupportedErr;
inline thread_local OSStatus maxQpSetStatus = kVTPropertyNotSupportedErr;
inline thread_local std::int64_t averageRequestedBps = 0, limitsRequestedBytes = 0;
inline thread_local int minQpRequested = 0;
inline thread_local int maxQpRequested = 51;
inline thread_local double limitsRequestedSeconds = 0;
inline std::map<int64_t, Provenance> submitted;
inline int64_t receivedPts = -1;
inline int64_t lastWirePts = -1;
inline unsigned long long packetCount = 0;
inline std::ofstream output, packets, admissions, properties, propertyEvents;
inline std::mutex propertyEventsMutex;
inline std::vector<Scene> scenes;
inline int width, height, fps, kbps, negotiatedKbps, burst;
inline std::atomic<bool> failed {false};
inline std::atomic<bool> stopRequested {false};
inline std::mutex stopMutex;
inline std::condition_variable stopCondition;
inline void stop() { stopRequested = true; stopCondition.notify_all(); }
inline bool waitUntil(Clock::time_point deadline) {
    std::unique_lock lock(stopMutex);
    stopCondition.wait_until(lock, deadline, [] { return stopRequested.load(); });
    return !stopRequested;
}
inline long long nowUs() { return std::chrono::duration_cast<std::chrono::microseconds>(Clock::now() - start).count(); }
inline void propertyJson(CFTypeRef value, std::ostream& stream = properties) {
    if (!value) { stream << "null"; return; }
    if (CFGetTypeID(value) == CFBooleanGetTypeID()) { stream << (CFBooleanGetValue(static_cast<CFBooleanRef>(value)) ? "true" : "false"); return; }
    if (CFGetTypeID(value) == CFNumberGetTypeID()) {
        double number = 0; CFNumberGetValue(static_cast<CFNumberRef>(value), kCFNumberDoubleType, &number);
        stream << number; return;
    }
    if (CFGetTypeID(value) == CFArrayGetTypeID()) {
        auto array = static_cast<CFArrayRef>(value); stream << '[';
        for (CFIndex i = 0; i < CFArrayGetCount(array); ++i) { if (i) stream << ','; propertyJson(CFArrayGetValueAtIndex(array, i), stream); }
        stream << ']'; return;
    }
    stream << "null";
}
inline void recordProperties(VTCompressionSessionRef session, int rate, bool constrained, bool saver, bool accepted) {
    properties << "{\"at_us\":" << nowUs() << ",\"requested_kbps\":" << rate << ",\"constrained\":" << constrained
               << ",\"saver\":" << saver << ",\"accepted\":" << accepted
               << ",\"requested_average_bps\":" << averageRequestedBps
               << ",\"requested_burst\":" << (averageRequestedBps && limitsRequestedSeconds ? limitsRequestedBytes * 8.0 / limitsRequestedSeconds / averageRequestedBps : 0)
               << ",\"requested_limit_bytes\":" << limitsRequestedBytes
               << ",\"requested_limit_seconds\":" << limitsRequestedSeconds << ",\"set_AverageBitRate_status\":" << averageSetStatus
               << ",\"set_DataRateLimits_status\":" << limitsSetStatus
               << ",\"requested_min_qp\":" << minQpRequested << ",\"set_MinAllowedFrameQP_status\":" << minQpSetStatus
               << ",\"requested_max_qp\":" << maxQpRequested << ",\"set_MaxAllowedFrameQP_status\":" << maxQpSetStatus;
    for (const auto& [name, key] : std::initializer_list<std::pair<const char*, CFStringRef>>{
            {"AverageBitRate", kVTCompressionPropertyKey_AverageBitRate}, {"DataRateLimits", kVTCompressionPropertyKey_DataRateLimits},
            {"ExpectedFrameRate", kVTCompressionPropertyKey_ExpectedFrameRate}, {"RealTime", kVTCompressionPropertyKey_RealTime},
            {"AllowFrameReordering", kVTCompressionPropertyKey_AllowFrameReordering}, {"MaxFrameDelayCount", kVTCompressionPropertyKey_MaxFrameDelayCount},
            {"MinAllowedFrameQP", kVTCompressionPropertyKey_MinAllowedFrameQP}, {"MaxAllowedFrameQP", kVTCompressionPropertyKey_MaxAllowedFrameQP}}) {
        CFTypeRef value = nullptr; const auto status = VTSessionCopyProperty(session, key, nullptr, &value);
        properties << ",\"" << name << "\":{\"status\":" << status << ",\"value\":"; propertyJson(value); properties << '}';
        if (value) CFRelease(value);
    }
    properties << "}\n";
}
inline int send(AVCodecContext* ctx, const AVFrame* frame) {
    auto meta = current;
    meta.submitUs = nowUs();
    meta.input = inputIndex;
    submitted[frame->pts] = meta;
    const auto began = Clock::now();
    const int result = avcodec_send_frame(ctx, frame);
    admissions << meta.input << ',' << meta.submitUs << ',' << meta.event << ',' << scenes.at(meta.scene).id
               << ',' << meta.captureUs << ',' << result << ','
               << std::chrono::duration_cast<std::chrono::microseconds>(Clock::now() - began).count() << ',' << frame->pts << '\n';
    return result;
}
inline int receive(AVCodecContext* ctx, AVPacket* packet) {
    const int result = avcodec_receive_packet(ctx, packet);
    if (result >= 0) receivedPts = packet->pts;
    return result;
}
}

// Observe setter return values without replacing the production rate adapter
// or interpreting an unsupported getter as proof that a requested limit exists.
extern "C" OSStatus VTSessionSetProperty(VTSessionRef session, CFStringRef key, CFTypeRef value) {
    using Setter = decltype(&VTSessionSetProperty);
    static const Setter setter = reinterpret_cast<Setter>(dlsym(RTLD_NEXT, "VTSessionSetProperty"));
    const auto status = setter ? setter(session, key, value) : kVTInvalidSessionErr;
    if (CFEqual(key, kVTCompressionPropertyKey_AverageBitRate)) {
        replay::averageSetStatus = status;
        if (value && CFGetTypeID(value) == CFNumberGetTypeID())
            CFNumberGetValue(static_cast<CFNumberRef>(value), kCFNumberSInt64Type, &replay::averageRequestedBps);
    }
    if (CFEqual(key, kVTCompressionPropertyKey_DataRateLimits)) {
        replay::limitsSetStatus = status;
        if (value && CFGetTypeID(value) == CFArrayGetTypeID() && CFArrayGetCount(static_cast<CFArrayRef>(value)) == 2) {
            auto values = static_cast<CFArrayRef>(value);
            CFNumberGetValue(static_cast<CFNumberRef>(CFArrayGetValueAtIndex(values, 0)), kCFNumberSInt64Type, &replay::limitsRequestedBytes);
            CFNumberGetValue(static_cast<CFNumberRef>(CFArrayGetValueAtIndex(values, 1)), kCFNumberDoubleType, &replay::limitsRequestedSeconds);
        }
    }
    if (CFEqual(key, kVTCompressionPropertyKey_MinAllowedFrameQP)) {
        replay::minQpSetStatus = status;
        if (value && CFGetTypeID(value) == CFNumberGetTypeID())
            CFNumberGetValue(static_cast<CFNumberRef>(value), kCFNumberIntType, &replay::minQpRequested);
    }
    if (CFEqual(key, kVTCompressionPropertyKey_MaxAllowedFrameQP)) {
        replay::maxQpSetStatus = status;
        if (value && CFGetTypeID(value) == CFNumberGetTypeID())
            CFNumberGetValue(static_cast<CFNumberRef>(value), kCFNumberIntType, &replay::maxQpRequested);
    }
    for (const auto& [name, observed] : std::initializer_list<std::pair<const char*, CFStringRef>>{
            {"AverageBitRate", kVTCompressionPropertyKey_AverageBitRate}, {"DataRateLimits", kVTCompressionPropertyKey_DataRateLimits},
            {"MinAllowedFrameQP", kVTCompressionPropertyKey_MinAllowedFrameQP}, {"MaxAllowedFrameQP", kVTCompressionPropertyKey_MaxAllowedFrameQP}}) {
        if (CFEqual(key, observed)) {
            std::lock_guard lock(replay::propertyEventsMutex);
            replay::propertyEvents << "{\"at_us\":" << replay::nowUs() << ",\"property\":\"" << name << "\",\"status\":" << status << ",\"requested\":";
            replay::propertyJson(value, replay::propertyEvents);
            replay::propertyEvents << "}\n";
            break;
        }
    }
    return status;
}

namespace platf {
struct img_t {
    virtual ~img_t() = default;
    std::optional<Clock::time_point> frame_timestamp;
    replay::Provenance provenance;
};
struct pixel_buffer_t {
    CVPixelBufferRef buf = nullptr;
    explicit pixel_buffer_t(CVPixelBufferRef value) : buf(value) {}
    ~pixel_buffer_t() { if (buf) CVPixelBufferRelease(buf); }
};
struct av_img_t : img_t { std::shared_ptr<pixel_buffer_t> pixel_buffer; };
struct encode_device_t {
    virtual ~encode_device_t() = default;
    virtual int convert(img_t&) = 0;
};
inline void free_frame(AVFrame* value) { av_frame_free(&value); }
inline void free_buffer(void*, uint8_t* data) { CVPixelBufferRelease(reinterpret_cast<CVPixelBufferRef>(data)); }
class nv12_zero_device : public encode_device_t {
public:
    std::unique_ptr<AVFrame, decltype(&free_frame)> av_frame {av_frame_alloc(), free_frame};
    AVFrame* frame = av_frame.get();
    int convert(img_t& img) override;
};
/* PRODUCTION_NATIVE_CONVERSION */

inline std::shared_ptr<img_t> image(int scene, int event, long long captureUs) {
    CVPixelBufferRef buffer = nullptr;
    if (CVPixelBufferCreate(nullptr, replay::width, replay::height, kCVPixelFormatType_420YpCbCr8BiPlanarVideoRange,
                            nullptr, &buffer) != kCVReturnSuccess) throw std::runtime_error("CVPixelBufferCreate failed");
    auto result = std::make_shared<av_img_t>();
    result->pixel_buffer = std::make_shared<pixel_buffer_t>(buffer);
    CVBufferSetAttachment(buffer, kCVImageBufferYCbCrMatrixKey, kCVImageBufferYCbCrMatrix_ITU_R_709_2, kCVAttachmentMode_ShouldPropagate);
    CVBufferSetAttachment(buffer, kCVImageBufferColorPrimariesKey, kCVImageBufferColorPrimaries_ITU_R_709_2, kCVAttachmentMode_ShouldPropagate);
    CVBufferSetAttachment(buffer, kCVImageBufferTransferFunctionKey, kCVImageBufferTransferFunction_ITU_R_709_2, kCVAttachmentMode_ShouldPropagate);
    CVPixelBufferLockBaseAddress(buffer, 0);
    auto& pixels = replay::scenes.at(scene).pixels;
    for (int plane = 0; plane < 2; ++plane) {
        auto* dest = static_cast<unsigned char*>(CVPixelBufferGetBaseAddressOfPlane(buffer, plane));
        const auto stride = CVPixelBufferGetBytesPerRowOfPlane(buffer, plane);
        const auto* source = pixels.data() + (plane ? replay::width * replay::height : 0);
        for (int y = 0; y < replay::height / (plane ? 2 : 1); ++y)
            std::memcpy(dest + y * stride, source + y * replay::width, replay::width);
    }
    CVPixelBufferUnlockBaseAddress(buffer, 0);
    result->provenance = {event, scene, captureUs, 0};
    result->frame_timestamp = replay::start + std::chrono::microseconds(captureUs);
    return result;
}
struct display_t {
    int width = replay::width, height = replay::height;
    std::shared_ptr<img_t> alloc_img() { return image(0, 0, 0); }
    int dummy_img(img_t*) { return 0; }
};
inline void enable_mouse_keys() {}
}

template<typename T> struct EventMailbox {
    mutable std::mutex mutex;
    std::condition_variable condition;
    std::optional<T> value;
    bool alive = true;
    void raise(T next) { { std::lock_guard lock(mutex); value = std::move(next); } condition.notify_one(); }
    template<typename Rep, typename Period> std::optional<T> pop(std::chrono::duration<Rep, Period> wait) {
        std::unique_lock lock(mutex);
        condition.wait_for(lock, wait, [&] { return value.has_value() || !alive; });
        auto result = std::move(value); value.reset(); return result;
    }
    std::optional<T> pop() { return pop(0ms); }
    bool peek() const { std::lock_guard lock(mutex); return value.has_value(); }
    bool running() const { std::lock_guard lock(mutex); return alive; }
    void stop() { { std::lock_guard lock(mutex); alive = false; } condition.notify_all(); }
};
struct ImageMailbox {
    EventMailbox<std::shared_ptr<platf::img_t>> mailbox;
    void raise(std::shared_ptr<platf::img_t> img) { mailbox.raise(std::move(img)); }
    bool peek() const { return mailbox.peek(); }
    bool running() const { return mailbox.running(); }
    void stop() { mailbox.stop(); }
    template<typename Rep, typename Period> std::shared_ptr<platf::img_t> pop(std::chrono::duration<Rep, Period> wait) {
        auto item = mailbox.pop(wait); return item ? *item : nullptr;
    }
};
struct packet_raw_avcodec {
    using replace_t = std::pair<std::string_view, std::string_view>;
    AVPacket* av_packet = av_packet_alloc();
    std::optional<Clock::time_point> frame_timestamp;
    std::vector<replace_t>* replacements = nullptr;
    void* channel_data = nullptr;
    ~packet_raw_avcodec() { av_packet_free(&av_packet); }
};
using packet_t = std::unique_ptr<packet_raw_avcodec>;
struct PacketSink {
    void raise(packet_t packet) {
        auto it = replay::submitted.find(replay::receivedPts);
        if (it == replay::submitted.end()) throw std::runtime_error("Packet PTS has no input provenance");
        const auto& meta = it->second;
        const auto* p = packet->av_packet;
        if (replay::lastWirePts >= 0 && p->pts != replay::lastWirePts + 1)
            throw std::runtime_error("Production output frame sequence is not contiguous");
        replay::lastWirePts = p->pts;
        replay::output.write(reinterpret_cast<const char*>(p->data), p->size);
        replay::packets << replay::packetCount++ << ',' << meta.input << ',' << meta.submitUs << ',' << meta.event << ','
                        << replay::scenes.at(meta.scene).id << ',' << replay::receivedPts << ',' << replay::receivedPts << ','
                        << p->size << ',' << bool(p->flags & AV_PKT_FLAG_KEY) << ',' << replay::nowUs() << ',' << meta.captureUs << ',' << p->pts << ',' << meta.event << '\n';
    }
};
namespace safe {
struct Mail {
    std::map<std::string, std::any> events;
    template<typename T> std::shared_ptr<EventMailbox<T>> event(std::string_view name) {
        const std::string key(name);
        auto& slot = events[key];
        if (!slot.has_value()) slot = std::make_shared<EventMailbox<T>>();
        return std::any_cast<std::shared_ptr<EventMailbox<T>>>(slot);
    }
};
using mail_t = std::shared_ptr<Mail>;
using signal_t = EventMailbox<bool>;
struct mail_raw_t { template<typename T> using queue_t = std::shared_ptr<PacketSink>; };
}
