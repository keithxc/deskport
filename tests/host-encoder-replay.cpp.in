struct config_t { int framerate = replay::fps, bitrate = replay::negotiatedKbps; bool deskport_smart = true, deskport_saver = true; };
inline constexpr int ASYNC_TEARDOWN = 1;
struct encoder_t { int flags = 0; };
struct CodecDeleter { void operator()(AVCodecContext* ctx) const { avcodec_free_context(&ctx); } };
struct encode_session_t {
    virtual ~encode_session_t() = default;
    virtual int convert(platf::img_t&) = 0;
    virtual void request_idr_frame() = 0;
    virtual void request_normal_frame() = 0;
    virtual void invalidate_ref_frames(int64_t, int64_t) = 0;
    virtual bool deskport_set_bitrate(int, bool, bool) = 0;
    virtual bool deskport_record_bitrate(int, bool, bool) = 0;
};
struct avcodec_encode_session_t : encode_session_t {
    std::unique_ptr<AVCodecContext, CodecDeleter> avcodec_ctx;
    std::unique_ptr<platf::nv12_zero_device> device;
    bool deskport_complete_vt_frames = true;
    deskport::KeyframeRequests deskport_keys;
#ifdef DESKPORT_REPLAY_HAS_PICTURE_QUALITY
    deskport::PictureQuality deskport_quality;
#endif
#ifdef DESKPORT_REPLAY_HAS_VT_CLOCK
    deskport::vt::FrameClock deskport_clock;
#endif
    int64_t deskport_last_pts = -1, deskport_pts_shift = 0;
    int inject = 0;
    cbs::nal_t sps, vps;
    std::vector<packet_raw_avcodec::replace_t> replacements;
    AVBufferRef *frames = nullptr, *hardware = nullptr;
    ~avcodec_encode_session_t() override { avcodec_ctx.reset(); device.reset(); av_buffer_unref(&frames); av_buffer_unref(&hardware); }
    int convert(platf::img_t& img) override { const int ret = device->convert(img); if (!ret) replay::current = img.provenance; return ret; }
    void request_idr_frame() override { device->frame->pict_type = AV_PICTURE_TYPE_I; device->frame->flags |= AV_FRAME_FLAG_KEY; }
    void request_normal_frame() override { device->frame->pict_type = AV_PICTURE_TYPE_NONE; device->frame->flags &= ~AV_FRAME_FLAG_KEY; }
    void invalidate_ref_frames(int64_t, int64_t) override { request_idr_frame(); }
/* PRODUCTION_RATE_SETTER */
    bool deskport_record_bitrate(int rate, bool constrained, bool saver) override {
        const bool accepted = deskport_set_bitrate(rate, constrained, saver);
        replay::recordProperties(deskport::vt::session(avcodec_ctx.get()), rate, constrained, saver, accepted);
        if (!accepted) { replay::failed = true; replay::stop(); throw std::runtime_error("Production encoder rejected rate/quality setup; replay stopped"); }
        return accepted;
    }
};
// Factory is the explicit adapter boundary; the encoder loop and submission
// functions below remain the exact generated production definitions.
inline std::unique_ptr<encode_session_t> make_encode_session(platf::display_t*, const encoder_t&, const config_t& config,
                                                          int width, int height, std::unique_ptr<platf::encode_device_t>) {
    auto result = std::make_unique<avcodec_encode_session_t>();
    const auto* codec = avcodec_find_encoder_by_name("hevc_videotoolbox");
    result->avcodec_ctx.reset(avcodec_alloc_context3(codec));
    auto* ctx = result->avcodec_ctx.get();
    if (!codec || !ctx) throw std::runtime_error("VideoToolbox encoder unavailable");
    ctx->width = width; ctx->height = height; ctx->pix_fmt = AV_PIX_FMT_VIDEOTOOLBOX; ctx->sw_pix_fmt = AV_PIX_FMT_NV12;
    ctx->time_base = {1, config.framerate}; ctx->framerate = {config.framerate, 1};
    ctx->flags = AV_CODEC_FLAG_CLOSED_GOP | AV_CODEC_FLAG_LOW_DELAY; ctx->flags2 = AV_CODEC_FLAG2_FAST;
    ctx->gop_size = 32767; ctx->max_b_frames = 0; ctx->refs = 1;
    ctx->color_range = AVCOL_RANGE_MPEG; ctx->colorspace = AVCOL_SPC_BT709;
    ctx->color_primaries = AVCOL_PRI_BT709; ctx->color_trc = AVCOL_TRC_BT709;
    ctx->bit_rate = ctx->rc_max_rate = ctx->rc_min_rate = std::int64_t(config.bitrate) * 1000;
    ctx->rc_buffer_size = int(ctx->bit_rate / config.framerate);
    if (av_hwdevice_ctx_create(&result->hardware, AV_HWDEVICE_TYPE_VIDEOTOOLBOX, nullptr, nullptr, 0) < 0) throw std::runtime_error("VT hardware context failed");
    result->frames = av_hwframe_ctx_alloc(result->hardware);
    auto* fctx = reinterpret_cast<AVHWFramesContext*>(result->frames->data);
    fctx->format = AV_PIX_FMT_VIDEOTOOLBOX; fctx->sw_format = AV_PIX_FMT_NV12;
    fctx->width = width; fctx->height = height;
    if (av_hwframe_ctx_init(result->frames) < 0) throw std::runtime_error("VT frame context failed");
    ctx->hw_frames_ctx = av_buffer_ref(result->frames);
    AVDictionary* options = nullptr;
    av_dict_set(&options, "realtime", "1", 0); av_dict_set(&options, "prio_speed", "1", 0); av_dict_set(&options, "max_ref_frames", "1", 0);
    const int ret = avcodec_open2(ctx, codec, &options); av_dict_free(&options);
    if (ret < 0) throw std::runtime_error("VT encoder creation failed");
    result->device = std::make_unique<platf::nv12_zero_device>();
    auto* frame = result->device->frame;
    frame->format = ctx->pix_fmt; frame->width = width; frame->height = height;
    frame->color_range = ctx->color_range; frame->colorspace = ctx->colorspace;
    frame->color_primaries = ctx->color_primaries; frame->color_trc = ctx->color_trc;
    return result;
}
#define avcodec_send_frame replay::send
#define avcodec_receive_packet replay::receive
/* PRODUCTION_AVCODEC_ENCODER */
#undef avcodec_send_frame
#undef avcodec_receive_packet
inline int encode(int64_t number, encode_session_t& session, safe::mail_raw_t::queue_t<packet_t>& packets,
                  void* channel, std::optional<Clock::time_point> timestamp) {
    replay::inputIndex = number;
    return encode_avcodec(number, dynamic_cast<avcodec_encode_session_t&>(session), packets, channel, timestamp);
}
