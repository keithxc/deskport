/* PRODUCTION_ASYNC_ENCODER */
#undef deskport_set_bitrate
}

int main(int argc, char** argv) {
    try {
        if (argc < 10 || argc > 12) throw std::runtime_error("usage: replay width height fps kbps burst durationMs scenes.list events.tsv prefix [negotiatedKbps [ceilingPermille]]");
        replay::width = std::stoi(argv[1]); replay::height = std::stoi(argv[2]); replay::fps = std::stoi(argv[3]);
        replay::kbps = std::stoi(argv[4]); replay::burst = std::stoi(argv[5]); const int duration = std::stoi(argv[6]);
        replay::negotiatedKbps = argc >= 11 ? std::stoi(argv[10]) : replay::kbps;
        const int ceilingPermille = argc == 12 ? std::stoi(argv[11]) : deskport::ceilingPermille(replay::kbps, replay::negotiatedKbps);
        if (replay::width <= 0 || replay::height <= 0 || replay::width % 2 || replay::height % 2 || replay::fps <= 0 || replay::kbps <= 0 || replay::negotiatedKbps < replay::kbps || replay::burst <= 0 || duration <= 0 || ceilingPermille < 0 || ceilingPermille > 1000)
            throw std::runtime_error("invalid replay dimensions/rate/duration");
        std::ifstream list(argv[7]); std::string line;
        while (std::getline(list, line)) {
            const auto tab = line.find('\t');
            if (tab == std::string::npos) throw std::runtime_error("invalid scenes.list");
            std::ifstream input(line.substr(tab + 1), std::ios::binary);
            replay::Scene scene {line.substr(0, tab), std::vector<unsigned char>(std::istreambuf_iterator<char>(input), {})};
            if (scene.pixels.size() != std::size_t(replay::width) * replay::height * 3 / 2) throw std::runtime_error("invalid NV12 file length");
            replay::scenes.push_back(std::move(scene));
        }
        if (replay::scenes.empty()) throw std::runtime_error("no scenes");
        std::vector<replay::Event> events;
        std::ifstream timeline(argv[8]);
        while (std::getline(timeline, line)) {
            std::istringstream row(line); replay::Event event {};
            if (!(row >> event.atUs >> event.scene >> event.activity >> event.recovery) || event.scene < 0 ||
                event.scene >= int(replay::scenes.size()) || (events.empty() ? event.atUs != 0 : event.atUs <= events.back().atUs))
                throw std::runtime_error("invalid timeline");
            events.push_back(event);
        }
        if (events.empty() || events.back().atUs >= duration * 1000LL) throw std::runtime_error("invalid timeline duration");
        const std::string prefix(argv[9]);
        std::filesystem::create_directories(std::filesystem::path(prefix).parent_path());
        for (const auto* suffix : {".hevc", ".packets.csv", ".admissions.csv", ".runtime.json", ".properties.jsonl", ".property-events.jsonl"})
            if (std::filesystem::exists(prefix + suffix)) throw std::runtime_error("Replay output already exists; choose a new prefix");
        replay::output.open(prefix + ".hevc", std::ios::binary);
        replay::packets.open(prefix + ".packets.csv");
        replay::admissions.open(prefix + ".admissions.csv");
        replay::properties.open(prefix + ".properties.jsonl");
        replay::propertyEvents.open(prefix + ".property-events.jsonl");
        if (!replay::output || !replay::packets || !replay::admissions || !replay::properties || !replay::propertyEvents) throw std::runtime_error("could not open output files");
        replay::packets << "wire_index,input,sim_us,event,scene,native_pts,packet_pts,bytes,key,output_us,capture_us,wire_pts,content_seq\n";
        replay::admissions << "input,submit_us,event,scene,capture_us,status,submit_duration_us,native_pts\n";
        auto mailbox = std::make_shared<safe::Mail>();
        auto images = std::make_shared<ImageMailbox>();
        safe::signal_t reinit;
        auto shutdown = mailbox->event<bool>(mail::shutdown);
        auto idr = mailbox->event<bool>(mail::idr);
        auto activity = mailbox->event<deskport::ActivityBoost>("deskport_activity");
        // Precreate all typed mailboxes before the producer and encoder run.
        mailbox->event<int>("deskport_congestion"); mailbox->event<int>("deskport_rtt");
        mailbox->event<int>("deskport_sent_kbps"); mailbox->event<int>("deskport_rate_kbps");
        mailbox->event<std::pair<int64_t, int64_t>>(mail::invalidate_ref_frames);
        deskport::liveSaver = 1;
        deskport::liveCeilingPermille = ceilingPermille;
        std::ofstream runtime(prefix + ".runtime.json");
        runtime << "{\"negotiatedKbps\":" << replay::negotiatedKbps << ",\"requestedCapKbps\":" << replay::kbps
                << ",\"ceilingPermille\":" << deskport::liveCeilingPermille.load()
                << ",\"effectiveCapKbps\":" << deskport::applyPermille(replay::negotiatedKbps, deskport::liveCeilingPermille.load())
                << ",\"requestedBurstHint\":" << replay::burst
                << ",\"codec\":\"hevc_videotoolbox\",\"factory\":\"test adapter\"}\n";
        replay::start = Clock::now();
        auto display = std::make_shared<platf::display_t>();
        int frame = 1;
        std::jthread producer([&] {
            try {
                for (int i = 0; i < int(events.size()); ++i) {
                    const auto& event = events[i];
                    if (!replay::waitUntil(replay::start + std::chrono::microseconds(event.atUs))) break;
                    images->raise(platf::image(event.scene, i, replay::nowUs()));
                    if (event.activity) activity->raise({std::chrono::duration_cast<std::chrono::milliseconds>(Clock::now().time_since_epoch()).count() + 350, 60});
                    if (event.recovery) idr->raise(true);
                }
                replay::waitUntil(replay::start + std::chrono::milliseconds(duration));
            } catch (const std::exception& error) { std::cerr << error.what() << '\n'; replay::failed = true; }
            shutdown->raise(true); images->stop();
        });
        auto stopOnExit = util::fail_guard([] { replay::stop(); });
        video::encode_run(frame, mailbox, images, {}, display, nullptr, reinit, {}, nullptr);
        replay::stop();
        producer.join();
        std::cout << "production asynchronous replay finished; submissions=" << frame - 1 << '\n';
        return replay::failed || replayError || frame <= 1 || replay::packetCount == 0 ? 1 : 0;
    } catch (const std::exception& error) { std::cerr << error.what() << '\n'; return 1; }
}
